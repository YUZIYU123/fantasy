{
  "name": "mist-page-fiction",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "CLOUDFLARE_ENV=local WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:staging": "CLOUDFLARE_ENV=staging WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "CLOUDFLARE_ENV=local WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:staging": "CLOUDFLARE_ENV=staging WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:production": "CLOUDFLARE_ENV=production WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "CLOUDFLARE_ENV=local WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && node --experimental-strip-types --test tests/*.test.mjs && pnpm run test:reader",
    "test:reader": "tsx --test tests/*.test.tsx",
    "test:smoke:staging": "node scripts/smoke-cloudflare.mjs staging",
    "test:smoke:staging:closed": "node scripts/smoke-cloudflare.mjs staging closed",
    "test:smoke:production": "node scripts/smoke-cloudflare.mjs production",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "cf:types": "CLOUDFLARE_ENV=local wrangler types",
    "cf:config:check": "node scripts/verify-cloudflare-config.mjs",
    "cf:ready:staging": "node scripts/verify-cloudflare-config.mjs --require-remote staging",
    "cf:ready:production": "node scripts/verify-cloudflare-config.mjs --require-remote production",
    "cf:secrets:staging": "node scripts/verify-cloudflare-secrets.mjs staging",
    "cf:secrets:production": "node scripts/verify-cloudflare-secrets.mjs production",
    "cf:registration-ready:staging": "node scripts/verify-cloudflare-config.mjs --require-registration staging",
    "cf:registration-ready:production": "node scripts/verify-cloudflare-config.mjs --require-registration production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply mist-page-fiction-local-db --local --env local",
    "db:migrate:staging": "pnpm run release:source:staging && pnpm run cf:ready:staging && wrangler d1 migrations apply mist-page-fiction-staging-db --remote --env staging",
    "db:migrate:production": "pnpm run release:source:production && pnpm run cf:ready:production && wrangler d1 migrations apply mist-page-fiction-db --remote --env production",
    "release:check": "pnpm typecheck && pnpm lint && pnpm db:migrate:local && pnpm test && pnpm build:production && pnpm cf:config:check",
    "release:source:staging": "node scripts/verify-release-source.mjs staging",
    "release:source:production": "node scripts/verify-release-source.mjs production",
    "deploy": "pnpm run deploy:staging",
    "deploy:staging": "pnpm run db:migrate:staging && pnpm run cf:secrets:staging && pnpm run build:staging && wrangler deploy --env staging",
    "deploy:production": "pnpm run db:migrate:production && pnpm run cf:secrets:production && pnpm run build:production && wrangler deploy --env production"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.10",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
